---
import Layouts from "../layouts/layouts.astro";
import { Image } from "astro:assets";
import tiger_pc from "../assets/Tiger/Tiger_pc_bgr.png"
---

<Layouts title="Mubashir Dawood | Full Stack Developer & Software Engineer" description="Personal portfolio of Mubashir Dawood, a Full Stack Developer specializing in JavaScript, Go, and AI integration. Explore my projects and skills.">
    <div id="hero">
        <section id="header">
            <h1 class="hero-title">Hi, my name is Mubashir</h1>
            <h3 class="hero-subtitle">I'm a wannabe developer from Cape Town,<br> South Africa</h3>
        </section>
        <div class="hero-tiger-wrapper">
            <Image src={tiger_pc} alt="Tiger" class="hero-tiger-img" loading="eager"/>
        </div>
        <div class="scroll-indicator">
            <div class="mouse"></div>
            <span class="scroll-text">Scroll</span>
        </div>
    </div>

    <section id="about-cta">
        <h1 class="about-heading">Lets work together</h1>
        <div class="about-text">
            <p>
                <span class="mobile-inline">I'm a wannabe developer from Cape Town, South Africa.</span>
                From optimizing complex data pipelines to scaling background workers, high-throughput APIs to crafting seamless progressive web apps. 
                I help awesome people turn ambitious ideas into fast, reliable, and accessible digital infrastructure.
            </p>
        </div>
        <a href="/about" class="about-cta-button">About me</a>
    </section>
    
    <section id="current-focus">
        <h1 class="section-title" style="font-size: 56px ;">Current Focus</h1>
        <div class="current-focus-subtitle">
            <p>Projects I'm currently working on</p>
        </div>
        <div class="current-projects">
            <div class="current-project-card" id="project-1">
                <!-- <div class="current-project-card-image">
                    <Image src="" alt="Project Logo" loading="lazy"/>
                </div> -->
                <h1>Workout Dashboard</h1>
                <p>
                    As a fitness enthusiast and someone who likes looking at data, I thought it would be cool to have a dashboard displaying all types of metrics.
                    With that idea in mind, I decided on a web app using react for the front end and the Recharts library to display those metrics.
                    I also added a chatbot via groq that analyses a users data via vector searching in the convex database.
                </p>
                <a href="https://github.com/MubashirD04/Workout_Dashboard" target="_blank" class="project-link">GitHub</a>
            </div>
            <div class="current-project-card" id="project-2">
                <!-- <div class="current-project-card-image">
                    <Image src="" alt="Project Logo" loading="lazy"/>
                </div> -->
                <h1>Circles</h1>
                <p>
                    A social media clone pwa. I wanted to test my svelte skills and backend skills such as rate limiting, load balancing and caching. 
                    The premise of this app was to be exclusive and media would only last for a month, sort of like bereal. 
                </p>
                <a href="" class="project-link">GitHub</a>
            </div>
        </div>
    </section>

    <section id="contact">
        <h2 class="section-title">Get In Touch</h2>
        <div class="card" style="max-width: 600px; margin: 0 auto; text-align: center;">
            <p style="margin-bottom: 20px;">Interested in working together? Let's build something extraordinary.</p>
            <p><strong>LinkedIn:</strong> 
                <a href="https://www.linkedin.com/in/mubashir-dawood-2b2a79206/" style="color: var(--primary-color);" target="_blank" rel="noopener noreferrer">linkedin.com/in/mubashir-dawood-a1b2c3d4/</a>
            </p>
            <p><strong>Email:</strong> mubashir.dawood4@gmail.com</p>
            <p><strong>GitHub:</strong> 
                <a href="https://github.com/MubashirD04" style="color: var(--primary-color);" target="_blank" rel="noopener noreferrer">github.com/MubashirD04</a>
            </p>
            <p><strong>WhatsApp:</strong>
                <a href="https://wa.me/27827605538" style="color: var(--primary-color);" target="_blank" rel="noopener noreferrer">+27 82 760 5538</a>
            </p>
            <a href="mailto:mubashir.dawood4@gmail.com" class="btn btn-primary">Send a Message</a>
        </div>
    </section>
</Layouts>
